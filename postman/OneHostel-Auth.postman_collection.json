{
  "info": {
    "name": "OneHostel Auth",
    "description": "One login for every account: POST /api/v1/auth/login with identifier, secret, authMode (PASSWORD / PASSCODE / OTP) and userType (SUPER_ADMIN / HOSTEL_OWNER / HOSTEL_TENANT). For OTP, run \"OTP 1\" first and use the code from the server log (dev) as the secret. Every successful login or refresh stores the access token in {{token}}, which the other requests send as a Bearer token. The refresh token is an HttpOnly cookie (oh_refresh) kept by Postman's cookie jar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "organizationId",
      "value": "org-sunrise-hostels"
    },
    {
      "key": "hostelId",
      "value": ""
    },
    {
      "key": "hostelVersion",
      "value": "0"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Any successful login or refresh stores its access token for the following requests.",
          "if (pm.response.code === 200 && pm.response.headers.has('Content-Type')) {",
          "    const body = pm.response.json();",
          "    if (body.responseObject && body.responseObject.accessToken) {",
          "        pm.collectionVariables.set('token', body.responseObject.accessToken);",
          "        console.log('Logged in as ' + body.responseObject.userProfile.role);",
          "    }",
          "}",
          "// Hostel create/update/inquire remember the record, so later hostel requests can use it.",
          "if ([200, 201].includes(pm.response.code) && pm.request.url.getPath().includes('/hostels/')) {",
          "    const record = pm.response.json().responseObject;",
          "    if (record && record.id && record.version !== undefined) {",
          "        pm.collectionVariables.set('hostelId', record.id);",
          "        pm.collectionVariables.set('hostelVersion', record.version);",
          "    }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login - super admin, password",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestObject\": {\n    \"identifier\": \"admin@onehostel.com\",\n    \"secret\": \"Admin@OneHostel2026\",\n    \"authMode\": \"PASSWORD\",\n    \"userType\": \"SUPER_ADMIN\"\n  },\n  \"clientSource\": \"WEB\"\n}"
        }
      }
    },
    {
      "name": "Login - super admin, passcode (by username)",
      "request": {
